# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── AUTH ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# ─── DATABASE ─────────────────────────────────────────────────────────────────
DB_PATH=./data/affplatform.db

# ─── SPONSOR API KEYS (fill after adding sponsors in dashboard) ───────────────
EVERFLOW_MM_API_KEY=
EVERFLOW_CS_API_KEY=
BIZAGLO_API_KEY=
SPHINXADS_API_KEY=
ADSURF_API_KEY=

# ─── FRONTEND URL (pour CORS) ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── SYNC INTERVAL (minutes) ─────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15
